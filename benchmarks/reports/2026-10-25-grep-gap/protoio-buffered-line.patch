+// at the next unread byte. takeLine only advances `head`: erasing the front
+// of a 64 KiB buffer for every line moved the rest of it each time.
+void compact(FdState& st) {
+    if (st.head == 0) return;
+    st.buf.erase(0, st.head);
+    st.head = 0;
