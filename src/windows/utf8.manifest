<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- protoClojure's strings, paths and arguments are UTF-8. On Windows 10 1903 and
     later this makes UTF-8 the process code page, so argv, getenv and every
     narrow-character Windows API take and return UTF-8 as on Linux and macOS. -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
