{
  "name": "protoclj-debug",
  "displayName": "protoClojure Debugger",
  "description": "Debug Clojure scripts with protoClojure (protoclj --dap): breakpoints (conditions, hit counts, log points), exception breakpoints, stepping (into clojure.core too), threads, call stack, locals, the Debug Console, path mappings and remote launch over ssh / wsl / docker. Uses VS Code's own Clojure syntax support; coexists with Calva.",
  "version": "0.4.0",
  "publisher": "protoclojure-placeholder",
  "engines": {
    "vscode": "^1.66.0"
  },
  "categories": [
    "Debuggers"
  ],
  "main": "./extension.js",
  "files": [
    "extension.js"
  ],
  "activationEvents": [
    "onDebug",
    "onDebugResolve:protoclj",
    "onDebugDynamicConfigurations:protoclj",
    "onLanguage:clojure"
  ],
  "contributes": {
    "configuration": {
      "title": "protoClojure",
      "properties": {
        "protoclj.path": {
          "type": "string",
          "default": "",
          "description": "Path to the protoclj executable. Leave empty to use the default install location (%LOCALAPPDATA%\\Programs\\proto\\bin\\protoclj.exe on Windows, ~/.local/bin/protoclj elsewhere) or else 'protoclj' from PATH."
        }
      }
    },
    "breakpoints": [
      {
        "language": "clojure"
      }
    ],
    "debuggers": [
      {
        "type": "protoclj",
        "label": "protoClojure",
        "languages": [
          "clojure"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Clojure (.clj) script to debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments for the script (*command-line-args*).",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the script's first form runs.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Working directory of the script (a client path when pathMappings apply). Default: the adapter's own."
              },
              "justMyCode": {
                "type": "boolean",
                "default": true,
                "description": "Step and pause only in the script's own code; clojure.core (embedded, read-only) is stepped over. Breakpoints set in clojure.core still stop. Set false to step into clojure.core's Clojure fns."
              },
              "pathMappings": {
                "type": "array",
                "description": "Maps the client's paths (localRoot) to the adapter's (remoteRoot), for a remote adapter. Longest prefix wins; separators and Windows drive-letter case are handled by the adapter.",
                "items": {
                  "type": "object",
                  "required": [
                    "localRoot",
                    "remoteRoot"
                  ],
                  "properties": {
                    "localRoot": {
                      "type": "string",
                      "description": "A directory on this machine, e.g. ${workspaceFolder}."
                    },
                    "remoteRoot": {
                      "type": "string",
                      "description": "The same directory where protoclj --dap runs."
                    }
                  }
                },
                "default": [
                  {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/home/me/project"
                  }
                ]
              },
              "remote": {
                "type": "object",
                "description": "Run the adapter elsewhere: `command` is the argv prefix that reaches the other machine (ssh, wsl, docker exec -i); the extension runs <command...> <path> --dap. Needs pathMappings.",
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "For example [\"ssh\", \"-T\", \"-o\", \"BatchMode=yes\", \"me@host\"], [\"wsl\", \"-d\", \"Ubuntu-24.04\", \"--\"], [\"docker\", \"exec\", \"-i\", \"ctr\"]."
                  },
                  "path": {
                    "type": "string",
                    "default": "protoclj",
                    "description": "protoclj on the remote side (default: protoclj on its PATH)."
                  }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "protoclj",
            "request": "launch",
            "name": "Debug current Clojure script (protoclj)",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "protoClojure: Launch current script",
            "description": "Debug the active .clj file with protoclj --dap.",
            "body": {
              "type": "protoclj",
              "request": "launch",
              "name": "Debug current Clojure script (protoclj)",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          },
          {
            "label": "protoClojure: Launch over SSH",
            "description": "Run protoclj --dap on another machine through ssh; the workspace is mapped to the remote checkout.",
            "body": {
              "type": "protoclj",
              "request": "launch",
              "name": "Debug over SSH (protoclj)",
              "program": "^\"\\${file}\"",
              "remote": {
                "command": [
                  "ssh",
                  "-T",
                  "-o",
                  "BatchMode=yes",
                  "user@host"
                ],
                "path": "protoclj"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          },
          {
            "label": "protoClojure: Launch in WSL",
            "description": "Run protoclj --dap inside a WSL distribution; the Windows workspace is mapped to the Linux checkout.",
            "body": {
              "type": "protoclj",
              "request": "launch",
              "name": "Debug in WSL (protoclj)",
              "program": "^\"\\${file}\"",
              "remote": {
                "command": [
                  "wsl",
                  "-d",
                  "Ubuntu-24.04",
                  "--"
                ],
                "path": "protoclj"
              },
              "pathMappings": [
                {
                  "localRoot": "^\"\\${workspaceFolder}\"",
                  "remoteRoot": "/home/user/project"
                }
              ]
            }
          }
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gamarino/protoClojure"
  },
  "license": "MIT",
  "extensionKind": [
    "workspace"
  ]
}
